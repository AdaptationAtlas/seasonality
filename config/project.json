{
  "project": "seasonality",
  "country": {
    "name": "Kenya",
    "iso3": "KEN"
  },
  "baseline": {
    "start_year": 2000,
    "end_year": 2024
  },
  "data_root_env": "ANALOGUE_DATA_ROOT",
  "data_root_default": "/Volumes/clim_dat",
  "phenology": {
    "max_seasons": 2,
    "min_years": 3,
    "ndvi_nse_min": 0.6,
    "ndvi_r2_min": 0.6
  },
  "season_windows": {
    "min_peak_separation_months": 3
  },
  "detectability": {
    "status": "provisional",
    "min_years_with_ndvi": 20,
    "ndvi_amplitude_min": 0.15,
    "humid_ndvi_amplitude_min": 0.20,
    "event_coverage_min": 0.40,
    "timing_concentration_min": 0.80,
    "rainfall_signal_min": 0.35,
    "rainfall_signal_floor": 0.25,
    "valley_strength_min": 0.30,
    "bimodal_year_coverage_min": 0.30,
    "wet_anomaly_min": 2.50
  },
  "validation": {
    "ceepa": {
      "article_id": 2069738,
      "doi": "10.6084/m9.figshare.c.1574094",
      "download_url": "https://ndownloader.figshare.com/files/3697976",
      "md5": "36e190be5b07c9a17a70f73164ba05cd",
      "comparison_year": 2003,
      "min_observed_records": 10,
      "min_remote_pixels": 10
    }
  },
  "outputs": {
    "table_format": "parquet",
    "raster_format": "COG",
    "runtime_log_format": "jsonl"
  }
}
